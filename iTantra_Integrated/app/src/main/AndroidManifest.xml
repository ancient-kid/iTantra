<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Speech capture / playback (STT + TTS) ===== -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Model pack downloads. The pipeline itself never uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ===== Mesh transport: legacy Bluetooth (Android 11 and below) ===== -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- ===== Mesh transport: modern Bluetooth (Android 12+) ===== -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Location is required by the OS for Wi-Fi Aware discovery -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ===== Mesh transport: Wi-Fi Aware ===== -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="@string/itantra_app_name"
        android:roundIcon="@android:drawable/ic_btn_speak_now"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.STTEnglishTest">

        <!-- Integrated walkie-talkie: voice -> STT -> mesh -> TTS -> voice -->
        <activity
            android:name="com.itantra.app.MainActivity"
            android:exported="true"
            android:label="@string/itantra_app_name"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Language model download manager -->
        <activity
            android:name="com.itantra.app.models.ModelsActivity"
            android:exported="false"
            android:label="Language models"
            android:screenOrientation="portrait" />

        <!-- Isolated STT/TTS model test bench, retained for per-module testing -->
        <activity
            android:name="com.itantra.stt.MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="portrait" />

    </application>

</manifest>
